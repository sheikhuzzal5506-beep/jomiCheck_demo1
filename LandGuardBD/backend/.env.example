# Easy local start (SQLite). For MySQL use the example below.
DATABASE_URL=sqlite:///./landguard.db
# DATABASE_URL=mysql+pymysql://landguard_user:change_me@localhost:3306/landguard_bd?charset=utf8mb4
SECRET_KEY=replace-this-with-a-long-random-secret-before-any-shared-deployment
ACCESS_TOKEN_MINUTES=60
UPLOAD_DIR=./private_uploads
MAX_UPLOAD_MB=10
